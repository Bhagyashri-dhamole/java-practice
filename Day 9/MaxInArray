import java.util.Scanner;
public class MaxInArray
{
	public static void main(String[] args) {
		Scanner Sc = new Scanner (System.in);
		int n = Sc.nextInt();
		int arr[] = new int[n]; // 4
		for(int i = 0; i<arr.length; i++)
		{
			arr[i] = Sc.nextInt(); //4 8 6 5
		}
		int max = arr[0]; //4
		for(int i = 0; i<arr.length; i++)
		{
			if(max < arr[i]) // 4 == 8
			{
				max = arr[i];
			}
		}
		System.out.print(max);
	}
}
