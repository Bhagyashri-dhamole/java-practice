class DigitsinAscendingOrder {
    public static void main(String[] args) {
        int n = 4523;
        int arr[] = new int[10];

        while (n > 0) {
            int d = n % 10;
            arr[d]++;
            n = n / 10;
        }

        for (int i = 0; i <= 9; i++) {
            while (arr[i] > 0) {
                System.out.print(i);
                arr[i]--;   
            }
        }
    }
}
