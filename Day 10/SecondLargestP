import java.util.Scanner;
class SecondLargest
{
	public static void main(String[] args) {
		Scanner Sc = new Scanner(System.in);
		int n = Sc.nextInt();
		int arr[] = new int[n];
		for(int i = 0;i < arr.length;i++)
		{
			arr[i] = Sc.nextInt();
		}
		int lar = arr[0];
		int sLar = 0;
		for(int i = 0;i < arr.length;i++)
		{
			if(lar < arr[i])
			{
				sLar = lar;
				lar = arr[i];
			}
		}
		System.out.print(sLar);
	}
}
