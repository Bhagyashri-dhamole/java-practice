import java.util.Scanner;
public class ReverseArray2
{
	public static void main(String[] args) {
		Scanner Sc = new Scanner(System.in);
		int n = Sc.nextInt();
		int arr[] = new int[n];
		for(int i = 0;i < arr.length;i++)
		{
			arr[i] = Sc.nextInt();
		}
		int i = 0;
		int j = arr.length-1;
		while(i < j)
		{
			int temp = arr[i];
			arr[i] = arr[j];
			arr[j] = temp;
			i++;
			j--;
		}
		for( i = 0;i < arr.length;i++)
		{
		System.out.print(arr[i]+ " ");
	    }
	}
}
